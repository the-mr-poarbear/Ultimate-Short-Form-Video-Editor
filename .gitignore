# ==============================================================================
# Git Ignore Configuration - Short Form Video Editor
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editor & IDE configurations
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# Environment Variables & Local Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.local
!.env.example
!.env.template

# ------------------------------------------------------------------------------
# Python & Backend
# ------------------------------------------------------------------------------
# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging / Distribution
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Linters & Type Checking
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Machine Learning / Whisper Model Checkpoints & Caches
.cache/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
whisper_models/

# ------------------------------------------------------------------------------
# Node.js & Frontend
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/

# Production build outputs
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Framework & Vite caches
.eslintcache
.stylelintcache
.vite/

# ------------------------------------------------------------------------------
# Application Workspace Data & User Uploads
# ------------------------------------------------------------------------------
# Ignore all project workspaces (uploaded videos, audio slices, renders, transcripts)
backend/projects/*
!backend/projects/.gitkeep

# Characters directory: ignore all user character uploads and character data
backend/characters/*
!backend/characters/.gitkeep

# Miscellaneous temp files
*.tmp
*.temp
